{
  "name": "mimic-linux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "linux:build": "tauri build --bundles deb",
    "linux:portable": "tauri build --no-bundle",
    "linux:package": "npm run linux:portable && python3 scripts/package.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
